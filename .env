# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Required variables cause the API/worker to refuse to start if missing —
# that's intentional (fail fast at boot, not mid-request).

# --- Core ---
APP_ENV=development
PORT=8080
# Public base URL of the API itself (used to build OAuth redirect URIs).
APP_BASE_URL=http://localhost:8080
# Public base URL of the frontend (used for CORS and post-OAuth/Stripe redirects).
FRONTEND_BASE_URL=http://localhost:5173

# --- Database / cache ---
DATABASE_URL=postgres://reporta:reporta@postgres:5432/reporta
REDIS_URL=redis://redis:6379

# --- Auth ---
# Any long random string (used to sign JWT access tokens). Generate with:
#   openssl rand -base64 48
JWT_SECRET=IAvOJqVz5kGPtYfOoOr5LlGLbnW8b0Wgx0ZLI6lrMdG6jo9gdqKaNLsj3zmvTwX2
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=1209600

# AES-256-GCM key (32 raw bytes, base64-encoded) used to encrypt OAuth
# tokens at rest. Generate a fresh one per environment — never reuse across
# dev/staging/prod, and never commit a real value. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=P5Hkcjk+jws3k5lokDu7WmpGTbGFy35GAZ+E5Zy9OvE=

# --- AI (Claude / Anthropic) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset; set to claude-opus-5 for higher quality.
ANTHROPIC_MODEL=claude-sonnet-4

# --- Billing (Stripe) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — endpoint: POST {APP_BASE_URL}/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=
# The recurring Price ID for the $29/mo plan (https://dashboard.stripe.com/products)
STRIPE_PRICE_ID=

# --- Meta (Facebook/Instagram Ads) ---
# https://developers.facebook.com/apps — needs the Marketing API product,
# `ads_read` permission, and a valid OAuth redirect URI of
# {APP_BASE_URL}/api/v1/integrations/meta/callback
META_APP_ID=
META_APP_SECRET=

# --- Google (GA4 + Google Ads share one OAuth client) ---
# https://console.cloud.google.com/apis/credentials — OAuth redirect URIs:
#   {APP_BASE_URL}/api/v1/integrations/ga4/callback
#   {APP_BASE_URL}/api/v1/integrations/google_ads/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://ads.google.com/aw/apicenter — required only for the Google Ads connection.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Email (for "Send to Client") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=reports@yourdomain.com

# --- File uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880
