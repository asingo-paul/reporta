# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Required variables cause the API/worker to refuse to start if missing —
# that's intentional (fail fast at boot, not mid-request).

# --- Core ---
APP_ENV=development
PORT=8080
# Public base URL of the API itself (used to build OAuth redirect URIs).
APP_BASE_URL=http://localhost:8080
# Public base URL of the frontend (used for CORS and post-OAuth/Stripe redirects).
FRONTEND_BASE_URL=http://localhost:5173

# --- Database / cache ---
DATABASE_URL=postgres://reporta:reporta@localhost:5432/reporta
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Any long random string (used to sign JWT access tokens). Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=1209600

# AES-256-GCM key (32 raw bytes, base64-encoded) used to encrypt OAuth
# tokens at rest. Generate a fresh one per environment — never reuse across
# dev/staging/prod, and never commit a real value. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# --- AI (any OpenAI-compatible provider) ---
# OPENAI_API_KEY is required for AI summaries (falls back to a deterministic
# template if empty). The endpoint is configurable so any OpenAI-compatible
# provider works:
#   Google Gemini free tier (get a key at https://aistudio.google.com/apikey):
#     https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#     model: gemini-3.6-flash  (use a NON-thinking model — a reasoning model can
#            spend the whole token budget thinking and return an empty summary)
#   Groq free tier:
#     https://api.groq.com/openai/v1/chat/completions
#     model: openai/gpt-oss-20b  (or llama-3.3-70b-versatile if your key has access)
#   OpenAI (paid):
#     https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
# Leave empty to default to OpenAI itself.
OPENAI_BASE_URL=
# Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=

# --- Billing (Stripe) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — endpoint: POST {APP_BASE_URL}/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=
# The recurring Price ID for the $29/mo plan (https://dashboard.stripe.com/products)
STRIPE_PRICE_ID=

# --- Meta (Facebook/Instagram Ads) ---
# https://developers.facebook.com/apps — needs the Marketing API product,
# `ads_read` permission, and a valid OAuth redirect URI of
# {APP_BASE_URL}/api/v1/integrations/meta/callback
META_APP_ID=
META_APP_SECRET=

# --- Google (GA4 + Google Ads share one OAuth client) ---
# https://console.cloud.google.com/apis/credentials — OAuth redirect URIs:
#   {APP_BASE_URL}/api/v1/integrations/ga4/callback
#   {APP_BASE_URL}/api/v1/integrations/google_ads/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://ads.google.com/aw/apicenter — required only for the Google Ads connection.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Email (for "Send to Client") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=reports@yourdomain.com

# --- File uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880
